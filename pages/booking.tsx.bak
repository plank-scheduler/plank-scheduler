import Head from "next/head";
import dynamic from "next/dynamic";

function buildSuccessBanner(id: string | null, dateTxt?: string | null, timeTxt?: string | null) {
  const idPart   = id ? ` — #${id}` : "";
  const datePart = (dateTxt && String(dateTxt).trim()) ? String(dateTxt) : "your requested date";
  const timePart = (timeTxt && String(timeTxt).trim()) ? String(timeTxt) : "your preferred time";
  return `Request sent${idPart}. We will contact you to confirm ${datePart} at ${timePart}.`;
}
const BookingClient = dynamic(() => import("../components/BookingClient"), { ssr: false });

