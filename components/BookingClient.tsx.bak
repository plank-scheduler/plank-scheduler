import React, { useEffect, useMemo, useState } from "react";
import SiteHeader from "./SiteHeader";
import { BRAND, GREETING, PLAN_OPTIONS, SERVICE_GROUPS, BOOKING_MODE } from "../lib/config";

function buildSuccessBanner(id: string | null, dateTxt?: string | null, timeTxt?: string | null) {
  const idPart   = id ? ` — #${id}` : "";
  const datePart = (dateTxt && String(dateTxt).trim()) ? String(dateTxt) : "your requested date";
  const timePart = (timeTxt && String(timeTxt).trim()) ? String(timeTxt) : "your preferred time";
  return `Request sent${idPart}. We will contact you to confirm ${datePart} at ${timePart}.`;
}

type Customer = { id: number; name: string; code?: string; phone?: string; address?: string };
type CustomersResp = { ok: true; data: Customer[] } | { ok: false; error: string };

const fmtDate = (d: Date) =>
  new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate())).toISOString().slice(0, 10);

function isPastDate(iso: string) {
  try {
    const today = new Date();
    const todayIso = new Date(Date.UTC(today.getFullYear(), today.getMonth(), today.getDate()))
      .toISOString()
      .slice(0, 10);
    return iso < todayIso;
  } catch {
    return false;
  }
}

function toAmPm(hhmm: string) {
  if (!/^\d{2}:\d{2}$/.test(hhmm)) return hhmm;
  const [hStr, mStr] = hhmm.split(":");
  let h = Number(hStr);
  const suffix = h >= 12 ? "PM" : "AM";
  h = ((h + 11) % 12) + 1;
  return `${h}:${mStr} ${suffix}`;
}

function isWithinWindow(hhmm: string, min = "07:30", max = "18:00") {
  // simple string compare works for HH:MM 24h
  return hhmm >= min && hhmm <= max;
}

export default function BookingClient() {
  const [customers, setCustomers] = useState<Customer[]>([]);
  const [customerId, setCustomerId] = useState<number | "">("");

  // Public inputs
  const [publicName, setPublicName] = useState("");
  const [publicPhone, setPublicPhone] = useState("");
  const [publicAddress, setPublicAddress] = useState("");
  const [publicEmail, setPublicEmail] = useState("");

  const [date, setDate] = useState<string>(fmtDate(new Date()));
  const [time, setTime] = useState<string>(""); // 24h HH:MM from input[type=time]
  const [plan, setPlan] = useState<string>("");
  const [service, setService] = useState<string>("");
  const [otherDetail, setOtherDetail] = useState<string>("");
  const [notes, setNotes] = useState<string>("");

  const [message, setMessage] = useState<string>("");
  const [msgKind, setMsgKind] = useState<"success" | "error" | "info">("info");

  useEffect(() => {
    if (BOOKING_MODE !== "admin") return;
    (async () => {
      try {
        const r = await fetch("/api/customers?limit=200");
        const j = (await r.json()) as CustomersResp;
        if ("ok" in j && j.ok) {
          setCustomers(j.data);
          if (j.data.length && customerId === "") setCustomerId(j.data[0].id);
        }
      } catch {}
    })();
  }, [customerId]);

  function validateBasics(): string | null {
    if (!date) return "Please choose a date.";
    if (isPastDate(date)) return "Please choose a future date.";
    if (!time) return "Please choose a preferred time.";
    if (!isWithinWindow(time, "07:30", "18:00")) return "Please choose a time between 7:30 AM and 6:00 PM.";
    if (!plan) return "Please select a plan.";
    if (!service) return "Please select a service.";
    if (service === "other" && !otherDetail.trim()) return "Please describe the service under 'Other'.";

    if (BOOKING_MODE === "admin") {
      if (!customerId) return "Please pick a customer.";
    } else {
      if (!publicName.trim()) return "Please enter your name.";
      if (!publicPhone.trim()) return "Please enter your phone.";
      if (!publicAddress.trim()) return "Please enter your address.";
      if (!publicEmail.trim()) return "Please enter your email.";
    }
    return null;
  }

  async function submitRequest() {
    const v = validateBasics();
    if (v) {
      setMessage(v);
      setMsgKind("error");
      return;
    }

    const serviceToSend =
      service === "other" && otherDetail.trim()
        ? \`Other — \${otherDetail.trim()}\`
        : service;

    // Snapshot the values the user picked BEFORE any resets
    const sentDate = date;
    const sentTime = toAmPm(time);

    // Build the payload expected by the API
    const payload =
      BOOKING_MODE === "admin"
        ? { customerId, date, time: sentTime, plan, service: serviceToSend, notes }
        : {
            customer: {
              name: publicName.trim(),
              phone: publicPhone.trim(),
              address: publicAddress.trim(),
              email: publicEmail.trim(),
            },
            date,
            time: sentTime,
            plan,
            service: serviceToSend,
            notes,
          };

    try {
      const res = await fetch("/api/appointments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data: any = {};
      try {
        const ct = res.headers.get("content-type") || "";
        data = ct.includes("application/json") ? await res.json() : {};
      } catch {}

      const messageId: string | null = data?.messageId ?? null;
      const banner = buildSuccessBanner(messageId, sentDate, sentTime);

      setMessage(banner);
      setMsgKind("success");

      // (Optional) you can reset fields here if you want, AFTER composing the banner:
      // setPlan(""); setService(""); setOtherDetail(""); setNotes(""); setTime("");
    } catch (e: any) {
      setMessage(\`Error: \${String(e?.message || e)}\`);
      setMsgKind("error");
    }
  }

  const CustomerSelect = useMemo(() => {
    if (BOOKING_MODE !== "admin") return null;
    return (
      <select
        value={customerId}
        onChange={(e) => setCustomerId(Number(e.target.value))}
        style={{ width: "100%", padding: 8 }}
      >
        <option value="">— Select a customer —</option>
        {customers.map((c) => (
          <option key={c.id} value={c.id}>
            {c.name} {c.code ? \`— \${c.code}\` : ""}
          </option>
        ))}
      </select>
    );
  }, [customers, customerId]);

  return (
    <div style={{ maxWidth: 980, margin: "0 auto", padding: "0 16px 24px" }}>
      <SiteHeader subtitle="— Booking" greeting={GREETING} />

      {message ? (
        <div
          style={{
            color: msgKind === "error" ? "crimson" : msgKind === "success" ? "green" : "#333",
            marginBottom: 12,
          }}
        >
          {message}
        </div>
      ) : null}

      {BOOKING_MODE === "admin" ? (
        <div style={{ marginBottom: 12 }}>
          <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Customer</label>
          {CustomerSelect}
        </div>
      ) : (
        <>
          <div style={{ marginBottom: 12 }}>
            <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Your name</label>
            <input
              value={publicName}
              onChange={(e) => setPublicName(e.target.value)}
              placeholder="Full name"
              style={{ width: "100%", padding: 8 }}
            />
          </div>
          <div style={{ marginBottom: 12 }}>
            <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Phone</label>
            <input
              value={publicPhone}
              onChange={(e) => setPublicPhone(e.target.value)}
              placeholder="Best contact number"
              style={{ width: "100%", padding: 8 }}
            />
          </div>
          <div style={{ marginBottom: 12 }}>
            <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Address</label>
            <input
              value={publicAddress}
              onChange={(e) => setPublicAddress(e.target.value)}
              placeholder="Service address"
              style={{ width: "100%", padding: 8 }}
            />
          </div>
          <div style={{ marginBottom: 12 }}>
            <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Email</label>
            <input
              value={publicEmail}
              onChange={(e) => setPublicEmail(e.target.value)}
              placeholder="you@example.com"
              style={{ width: "100%", padding: 8 }}
            />
          </div>
        </>
      )}

      <div style={{ marginBottom: 12, display: "flex", gap: 12, alignItems: "center" }}>
        <div>
          <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Date</label>
          <input type="date" value={date} onChange={(e) => setDate(e.target.value)} style={{ padding: 8 }} />
        </div>
        <div>
          <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>
            Preferred time <span style={{ fontWeight: 400 }}>(7:30 AM – 6:00 PM)</span>
          </label>
          <input
            type="time"
            value={time}
            onChange={(e) => setTime(e.target.value)}
            min="07:30"
            max="18:00"
            step={300}
            style={{ padding: 8 }}
          />
        </div>
      </div>

      <div style={{ marginBottom: 12 }}>
        <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Plan</label>
        <select value={plan} onChange={(e) => setPlan(e.target.value)} style={{ width: 280, padding: 8 }}>
          <option value="">— Select a plan —</option>
          {PLAN_OPTIONS.map((p) => (
            <option key={p.value} value={p.value}>
              {p.label}
            </option>
          ))}
        </select>
      </div>

      <div style={{ marginBottom: 12 }}>
        <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Service</label>
        <select value={service} onChange={(e) => setService(e.target.value)} style={{ width: 360, padding: 8 }}>
          <option value="">— Select a service —</option>
          {SERVICE_GROUPS.map((g) => (
            <optgroup key={g.group} label={g.group}>
              {g.options.map((s) => (
                <option key={s.value} value={s.value}>
                  {s.label}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
      </div>

      {service === "other" && (
        <div style={{ marginBottom: 12 }}>
          <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Other service (describe)</label>
          <input
            value={otherDetail}
            onChange={(e) => setOtherDetail(e.target.value)}
            placeholder="Describe the issue/service you need"
            style={{ width: "100%", padding: 8 }}
          />
        </div>
      )}

      <div style={{ marginBottom: 12 }}>
        <label style={{ display: "block", fontWeight: 600, marginBottom: 4 }}>Notes</label>
        <textarea
          value={notes}
          onChange={(e) => setNotes(e.target.value)}
          placeholder="Gate code, pet info, special instructions…"
          rows={3}
          style={{ width: "100%", padding: 8 }}
        />
      </div>

      <button
        onClick={submitRequest}
        style={{
          width: "100%",
          padding: "10px 14px",
          borderRadius: 6,
          border: "1px solid #ccc",
          background: "#f5f5f5",
          cursor: "pointer",
        }}
      >
        Request appointment
      </button>

      <div style={{ marginTop: 40, fontSize: 12, color: "#666", textAlign: "center" }}>
        Serving South Central Missouri • {BRAND}
      </div>
    </div>
  );
}
